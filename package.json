{
  "name": "@bydtech/llms-txt",
  "version": "0.1.1",
  "description": "Build and lint llms.txt files: from a config, or by crawling your sitemap into llms.txt and llms-full.txt.",
  "keywords": [
    "llms.txt",
    "llms-full.txt",
    "llm",
    "ai",
    "seo",
    "sitemap",
    "markdown",
    "html-to-markdown",
    "lint",
    "cli"
  ],
  "homepage": "https://github.com/BYDTechSolutions/llms-txt#readme",
  "bugs": {
    "url": "https://github.com/BYDTechSolutions/llms-txt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BYDTechSolutions/llms-txt.git"
  },
  "license": "MIT",
  "author": "BYD Tech <sales.bydtech@gmail.com> (https://bydtech.in)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "llms-txt": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
